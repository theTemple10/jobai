# Copy to .env.local for local use; put production values in Vercel settings.
# Do not put secret values in this committed example.
# Run npm run check:config to see missing variable names without printing values.

# Public values: safe in the browser when the migration's RLS policies are applied.
VITE_SUPABASE_URL=https://qxhkrepvoqnsxcofarno.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server configuration. Never prefix these secrets with VITE_.
SUPABASE_URL=https://qxhkrepvoqnsxcofarno.supabase.co
SUPABASE_PUBLISHABLE_KEY=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Set only after verifying a currently available vision-capable model.
GROQ_VISION_MODEL=
JSEARCH_KEY=

# Optional EmailJS public client configuration.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Production canonical origin (keep the existing deployment until a new domain is chosen).
VITE_PUBLIC_SITE_URL=https://jobai-orpin.vercel.app
# Optional private contact address shown on the data/privacy page.
VITE_SUPPORT_EMAIL=
