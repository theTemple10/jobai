{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(builder|jobs|account)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/builder",
      "destination": "/builder/index.html"
    },
    {
      "source": "/jobs",
      "destination": "/jobs/index.html"
    },
    {
      "source": "/account",
      "destination": "/account/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/help",
      "destination": "/help/index.html"
    }
  ]
}
